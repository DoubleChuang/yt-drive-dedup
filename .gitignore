# Google OAuth credentials / tokens - never commit these
token.json
.oauth_pending.json
client_secret*.json
credentials.json

# Volume mounts: keep the directories, ignore their contents
data/*
!data/.gitkeep
secrets/*
!secrets/.gitkeep

# Generated reports
*.csv

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.DS_Store
